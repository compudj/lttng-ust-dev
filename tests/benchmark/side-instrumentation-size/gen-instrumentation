"""
Generate the instrumentation the size benchmark measures: the same set
of events described once as LTTng-UST tracepoints and once as libside
events.

Every event has between one and eight fields, and no two events have
the same shape: the number of fields and the types they use both walk
through their cycles, so nothing the compiler sees is a duplicate of
anything else it has already seen.
"""

import argparse
import pathlib

# The field types, in the two spellings. Each entry is:
#   suffix, C type, how a tracepoint declares the field, how libside
#   declares it, and the argument a call site passes.
TYPES = [
    ("u8", "uint8_t", "lttng_ust_field_integer", "side_field_u8", "side_arg_u8", "1"),
    ("u16", "uint16_t", "lttng_ust_field_integer", "side_field_u16", "side_arg_u16", "2"),
    ("u32", "uint32_t", "lttng_ust_field_integer", "side_field_u32", "side_arg_u32", "3"),
    ("u64", "uint64_t", "lttng_ust_field_integer", "side_field_u64", "side_arg_u64", "4"),
    ("s16", "int16_t", "lttng_ust_field_integer", "side_field_s16", "side_arg_s16", "-5"),
    ("s32", "int32_t", "lttng_ust_field_integer", "side_field_s32", "side_arg_s32", "-6"),
    ("s64", "int64_t", "lttng_ust_field_integer", "side_field_s64", "side_arg_s64", "-7"),
    ("str", "const char *", "lttng_ust_field_string", "side_field_string", "side_arg_string", '"s"'),
]

PROVIDER_TP = "size_bench_tp"
PROVIDER_SIDE = "size_bench_side"

HEADER = """/*
 * SPDX-FileCopyrightText: 2026 EfficiOS, Inc
 *
 * SPDX-License-Identifier: LGPL-2.1-only
 *
 * Generated by gen-instrumentation. Do not edit.
 */

"""


def fields_of(i):
    """The fields of event `i`: one to eight of them, of walking types."""
    nr = (i % 8) + 1
    return [TYPES[(i + f) % len(TYPES)] for f in range(nr)]


def gen_tp_events(nr_events):
    out = [HEADER]
    out.append(f"""#undef LTTNG_UST_TRACEPOINT_PROVIDER
#define LTTNG_UST_TRACEPOINT_PROVIDER {PROVIDER_TP}

#undef LTTNG_UST_TRACEPOINT_INCLUDE
#define LTTNG_UST_TRACEPOINT_INCLUDE "./tp-events.h"

#if !defined(_SIZE_BENCH_TP_EVENTS_H) || defined(LTTNG_UST_TRACEPOINT_HEADER_MULTI_READ)
#define _SIZE_BENCH_TP_EVENTS_H

#include <lttng/tracepoint.h>
#include <stdint.h>

""")

    for i in range(nr_events):
        fields = fields_of(i)
        args = ", ".join(f"{ctype}, a{n}" for n, (_, ctype, _, _, _, _) in enumerate(fields))
        decls = []

        for n, (_, ctype, tp_decl, _, _, _) in enumerate(fields):
            if tp_decl == "lttng_ust_field_string":
                decls.append(f"\t\t{tp_decl}(f{n}, a{n})")
            else:
                decls.append(f"\t\t{tp_decl}({ctype}, f{n}, a{n})")

        out.append(f"""LTTNG_UST_TRACEPOINT_EVENT(
	{PROVIDER_TP},
	ev{i},
	LTTNG_UST_TP_ARGS({args}),
	LTTNG_UST_TP_FIELDS(
{chr(10).join(decls)}
	)
)

""")

    out.append("""#endif /* _SIZE_BENCH_TP_EVENTS_H */

#include <lttng/tracepoint-event.h>
""")
    return "".join(out)


def gen_tp_callsites(nr_events):
    out = [HEADER]

    for i in range(nr_events):
        vals = ", ".join(v for _, _, _, _, _, v in fields_of(i))
        out.append(f"\tlttng_ust_tracepoint({PROVIDER_TP}, ev{i}, {vals});\n")

    return "".join(out)


def gen_side_events(nr_events):
    out = [HEADER, "#include <side/trace.h>\n\n"]

    for i in range(nr_events):
        decls = "\n".join(
            f'\t\t{side_decl}("f{n}"),'
            for n, (_, _, _, side_decl, _, _) in enumerate(fields_of(i))
        )
        out.append(f"""side_static_event(side_ev{i}, "{PROVIDER_SIDE}", "ev{i}", SIDE_LOGLEVEL_INFO,
	side_field_list(
{decls}
	)
);

""")

    return "".join(out)


def gen_side_callsites(nr_events):
    out = [HEADER]

    for i in range(nr_events):
        args = ", ".join(
            f"{side_arg}({v})" for _, _, _, _, side_arg, v in fields_of(i)
        )
        out.append(f"\tside_event(side_ev{i}, side_arg_list({args}));\n")

    return "".join(out)


def main():
    p = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    p.add_argument("--events", type=int, default=1000, help="how many events")
    p.add_argument("--output-dir", default=".", help="where to write them")
    args = p.parse_args()

    out = pathlib.Path(args.output_dir)
    out.mkdir(parents=True, exist_ok=True)

    for name, text in (
        ("tp-events.h", gen_tp_events(args.events)),
        ("tp-callsites.h", gen_tp_callsites(args.events)),
        ("side-events.h", gen_side_events(args.events)),
        ("side-callsites.h", gen_side_callsites(args.events)),
    ):
        (out / name).write_text(text)

    print(f"generated {args.events} events into {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
